+
+  async updateProfile(id: string, updateDto: any): Promise<UserDocument> {
+    const user = await this.userModel.findByIdAndUpdate(
+      id,
+      { $set: updateDto },
+      { new: true }
+    ).exec();
+    
+    if (!user) {
+      throw new NotFoundException('User not found');
+    }
+    return user;
+  }
 }
